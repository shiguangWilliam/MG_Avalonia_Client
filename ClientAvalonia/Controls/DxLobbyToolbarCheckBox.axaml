<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClientAvalonia.Rendering"
             x:Class="ClientAvalonia.Controls.DxLobbyToolbarCheckBox"
             x:DataType="vm:UiNodeViewModel"
             Background="Transparent"
             Height="{Binding Height}"
             IsVisible="{Binding IsVisible}"
             IsEnabled="{Binding IsEnabled}"
             ToolTip.Tip="{Binding ToolTip}"
             Cursor="Hand"
             Tapped="OnTapped">
  <Border Background="#6614100C"
          BorderBrush="#6B4E2E"
          BorderThickness="1"
          CornerRadius="6"
          Padding="10,6"
          VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Panel Width="16" Height="16" VerticalAlignment="Center">
        <Border BorderBrush="#8B7355"
                BorderThickness="1"
                Background="#14100C"
                CornerRadius="8"
                IsVisible="{Binding IsChecked, Converter={x:Static BoolConverters.Not}}" />
        <Border BorderBrush="#FFA648"
                BorderThickness="1"
                Background="#FFA648"
                CornerRadius="8"
                IsVisible="{Binding IsChecked}" />
      </Panel>
      <TextBlock Text="{Binding Text}"
                 Foreground="{Binding ForegroundBrush}"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="11"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap" />
    </StackPanel>
  </Border>
</UserControl>
