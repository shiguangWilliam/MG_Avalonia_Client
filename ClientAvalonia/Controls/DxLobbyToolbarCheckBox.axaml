<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClientAvalonia.Rendering"
             x:Class="ClientAvalonia.Controls.DxLobbyToolbarCheckBox"
             x:DataType="vm:UiNodeViewModel"
             Background="Transparent"
             Height="{Binding Height}"
             IsVisible="{Binding IsVisible}"
             IsEnabled="{Binding IsEnabled}"
             ToolTip.Tip="{Binding ToolTip}"
             Cursor="Hand"
             Tapped="OnTapped">
  <Border Background="#5514100C"
          BorderBrush="#6B4E2E"
          BorderThickness="1"
          CornerRadius="6"
          Padding="8,0"
          VerticalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <Border Width="14"
              Height="14"
              CornerRadius="3"
              BorderBrush="#8B7355"
              BorderThickness="1"
              Background="#14100C"
              VerticalAlignment="Center">
        <Border Width="8"
                Height="8"
                CornerRadius="2"
                Background="#FFA648"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding IsChecked}" />
      </Border>
      <TextBlock Text="{Binding Text}"
                 Foreground="#FFD8C4A0"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="11"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 TextWrapping="NoWrap" />
    </StackPanel>
  </Border>
</UserControl>
