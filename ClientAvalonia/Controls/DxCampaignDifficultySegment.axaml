<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClientAvalonia.Controls.DxCampaignDifficultySegment">
  <!-- Connected three-segment control: hairline outline, internal 1px dividers,
       active segment marked by a 2px accent top bar instead of a heavy border. -->
  <Border Background="{DynamicResource DxSurface1Brush}"
          BorderBrush="{DynamicResource DxLineBrush}"
          BorderThickness="1">
    <Grid ColumnDefinitions="*,*,*">
      <Button x:Name="SegmentCasual" Grid.Column="0" Classes="segment" Content="CASUAL" />
      <Button x:Name="SegmentStandard" Grid.Column="1" Classes="segment" Content="STANDARD" />
      <Button x:Name="SegmentMental" Grid.Column="2" Classes="segment" Content="MENTAL" />
      <Border Grid.Column="1" Width="1" Background="{DynamicResource DxLineMutedBrush}" IsHitTestVisible="False" />
      <Border Grid.Column="2" Width="1" Background="{DynamicResource DxLineMutedBrush}" IsHitTestVisible="False" />
    </Grid>
  </Border>

  <UserControl.Styles>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0,9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DxTextMutedBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{DynamicResource DxTextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Foreground" Value="{DynamicResource DxAccentPrimaryBrush}" />
      <Setter Property="Background" Value="{DynamicResource DxSurfaceSelectedBrush}" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
</UserControl>
