<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClientAvalonia.Rendering"
             x:Class="ClientAvalonia.Controls.DxTextureButton"
             x:DataType="vm:UiNodeViewModel"
             Width="{Binding Width}"
             Height="{Binding Height}"
             IsVisible="{Binding IsVisible}">
  <Button Background="Transparent"
          BorderThickness="0"
          Padding="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch"
          Command="{Binding ClickCommand}"
          IsEnabled="{Binding IsEnabled}"
          ToolTip.Tip="{Binding ToolTip}"
          Cursor="Hand"
          PointerEntered="OnPointerEntered"
          PointerExited="OnPointerExited">
    <Panel>
      <Image x:Name="IdleImage"
             Source="{Binding IdleImage}"
             Stretch="Fill"
             IsHitTestVisible="False"
             IsVisible="{Binding IdleImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <Image x:Name="HoverImage"
             Source="{Binding HoverImage}"
             Stretch="Fill"
             IsHitTestVisible="False"
             IsVisible="False" />
      <TextBlock Text="{Binding ButtonLabel}"
                 Foreground="{Binding ForegroundBrush}"
                 FontFamily="{Binding LabelFontFamily}"
                 FontSize="{Binding FontSize}"
                 FontWeight="SemiBold"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 TextAlignment="Center"
                 IsVisible="{Binding ShowButtonText}" />
      <Border Background="#221C16"
              BorderBrush="#5A4632"
              BorderThickness="1"
              CornerRadius="6"
              IsVisible="{Binding HasTextureImage, Converter={x:Static BoolConverters.Not}}">
        <Border.Styles>
          <Style Selector="Border">
            <Setter Property="Transitions">
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
              </Transitions>
            </Setter>
          </Style>
        </Border.Styles>
        <TextBlock Text="{Binding ButtonLabel}"
                   Foreground="{Binding ForegroundBrush}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="SemiBold"
                   Margin="12,6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />
      </Border>
    </Panel>
  </Button>
</UserControl>
