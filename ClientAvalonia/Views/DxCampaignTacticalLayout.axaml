<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:ClientAvalonia.Views"
             xmlns:ctrl="using:ClientAvalonia.Controls"
             xmlns:vm="using:ClientAvalonia.Rendering"
             x:Class="ClientAvalonia.Views.DxCampaignTacticalLayout"
             x:DataType="vm:UiNodeViewModel"
             ClipToBounds="True">

  <UserControl.Styles>
    <Style Selector="TextBlock.tactical-column-title">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="3" />
      <Setter Property="Foreground" Value="{DynamicResource DxTextMutedBrush}" />
    </Style>
    <!-- Floating glass panels: translucent dark fill + hairline border + soft
         drop shadow so they read as HUD glass hovering over the globe. -->
    <Style Selector="Border.tactical-panel">
      <Setter Property="BorderBrush" Value="{DynamicResource DxLineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource DxCampaignSurfaceGradient}" />
      <Setter Property="Padding" Value="10,10" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #66000000" />
    </Style>
    <Style Selector="Border.accent-rail">
      <Setter Property="Width" Value="2" />
      <Setter Property="Background" Value="{DynamicResource DxAccentPrimaryBrush}" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>

  <!-- Globe-dominant composition: the sphere fills the frame behind everything;
       side panels float over its edges so the earth owns the visual center. -->
  <Panel>

    <!-- Starfield plate behind the globe (Tactical art). -->
    <Image x:Name="StarfieldPlate"
           Stretch="UniformToFill"
           Opacity="0.55"
           IsHitTestVisible="False"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch" />

    <!-- ============ Globe layer (full-frame backdrop) ============ -->
    <ctrl:DxCampaignGlobeHost x:Name="GlobeHost"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              OverlayRoot="{Binding}" />

    <!-- ============ Side panels ============ -->
    <Grid ColumnDefinitions="Auto,*,Auto"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch">

      <!-- Left column: faction tabs + mission list -->
      <Border x:Name="LeftPanel"
              Grid.Column="0"
              Classes="tactical-panel"
              Width="300"
              Margin="18,18,0,18"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Left">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="CAMPAIGN"
                       Classes="tactical-column-title" />
            <StackPanel x:Name="SideTabs"
                        Orientation="Horizontal"
                        Spacing="6" />
          </StackPanel>
          <Border BorderThickness="0,1,0,0"
                  BorderBrush="{DynamicResource DxLineMutedBrush}"
                  VerticalAlignment="Stretch">
            <ContentControl x:Name="ListHost" Margin="0,8,0,0" />
          </Border>
        </DockPanel>
      </Border>
      <!-- Accent rail on the globe-facing (right) edge of the left panel -->
      <Border Classes="accent-rail"
              Grid.Column="0"
              HorizontalAlignment="Right"
              Margin="0,18,0,18" />

      <!-- Center column reserved for the globe (columns clamp it visually) -->
      <Border Grid.Column="1" Background="Transparent" IsHitTestVisible="False" />

      <!-- Right column: briefing + difficulty + actions -->
      <Border x:Name="RightPanel"
              Grid.Column="2"
              Classes="tactical-panel"
              Width="340"
              Margin="0,18,18,18"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Right">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top"
                     Text="BRIEFING"
                     Classes="tactical-column-title"
                     Margin="0,0,0,10" />
          <ContentControl x:Name="BriefingHost" VerticalAlignment="Stretch" />
        </DockPanel>
      </Border>
      <!-- Accent rail on the globe-facing (left) edge of the right panel -->
      <Border Classes="accent-rail"
              Grid.Column="2"
              HorizontalAlignment="Left"
              Margin="0,18,0,18" />
    </Grid>

    <!-- Bottom action bar spans the full width beneath the globe horizon -->
    <Border Classes="tactical-panel"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,16"
            Padding="14,10"
            CornerRadius="0">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <ContentControl x:Name="DifficultyHeaderHost" VerticalAlignment="Center" />
        <Border Width="1"
                Height="16"
                Background="{DynamicResource DxLineMutedBrush}"
                VerticalAlignment="Center" />
        <ContentControl x:Name="DifficultyHost" VerticalAlignment="Center" />
        <Border Width="1"
                Height="16"
                Background="{DynamicResource DxLineMutedBrush}"
                VerticalAlignment="Center" />
        <StackPanel x:Name="ButtonsRow"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Unmapped INI controls are kept alive (bindings keep working) but hidden. -->
    <Panel x:Name="MiscHost" IsVisible="False" />
  </Panel>
</UserControl>
