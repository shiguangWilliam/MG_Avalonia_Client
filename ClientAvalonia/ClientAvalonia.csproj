<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DisableGitVersionTask>true</DisableGitVersionTask>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ClientAvalonia.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Description>CnCNet Avalonia UI Client</Description>
    <AssemblyTitle>CnCNet Client (Avalonia)</AssemblyTitle>
    <RootNamespace>ClientAvalonia</RootNamespace>
    <ApplicationIcon>..\DXMainClient\clienticon.ico</ApplicationIcon>
    <AssemblyName>ClientAvalonia</AssemblyName>
  </PropertyGroup>

  <!-- Release: self-contained single-file exe — see note/clientavalonia-build.md -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishProfile>win-x64-singlefile</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Ensures ClientUpdater HTTP deps are copied on publish -->
    <PackageReference Include="Microsoft.AspNet.WebApi.Client" />
    <PackageReference Include="System.DirectoryServices" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClientCore\ClientCore.csproj" />
    <ProjectReference Include="..\ClientUpdater\ClientUpdater.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DXMainClient\Resources\DTA\MainMenu.ini" Link="Resources\DTA\MainMenu.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
