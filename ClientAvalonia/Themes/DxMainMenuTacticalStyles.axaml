<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ClientAvalonia.Rendering"
                    xmlns:views="using:ClientAvalonia.Views">

  <!-- ==========================================================================
       Tactical main-menu command console. Selected by DxNodeTemplateSelector when
       VisualStyle=Tactical and WindowName=MainMenu. Fluent chrome + ButtonLabel;
       INI control IDs and MainMenuBehaviors stay untouched. Genesis backdrop
       remains the full-bleed hero behind this HUD.
       ========================================================================== -->

  <DataTemplate x:Key="DxMainMenuTacticalRoot" DataType="vm:UiNodeViewModel">
    <Panel IsVisible="{Binding IsVisible}"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           ClipToBounds="True"
           Background="Transparent">
      <!-- No opaque chrome — SolarSystemBackdropView in MainWindow must show through. -->
      <views:DxMainMenuTacticalLayout />
    </Panel>
  </DataTemplate>

  <!-- Campaign (primary): accent left notch + bold label. -->
  <DataTemplate x:Key="DxMainMenuTacticalNavPrimary" DataType="vm:UiNodeViewModel">
    <Button MinHeight="40"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            Cursor="Hand"
            Classes="tactical-nav-primary">
      <Button.Styles>
        <Style Selector="Button.tactical-nav-primary">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="12,8" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="{TemplateBinding Padding}">
                <Grid ColumnDefinitions="4,*">
                  <Border x:Name="Notch"
                          Grid.Column="0"
                          Width="3"
                          Margin="0,2,8,2"
                          Background="{DynamicResource DxAccentPrimaryBrush}"
                          Opacity="0.85" />
                  <!-- Content= is required — without it the label TextBlock never appears. -->
                  <ContentPresenter Grid.Column="1"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button.tactical-nav-primary:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource DxAccentGlowBrush}" />
          <Setter Property="RenderTransform" Value="translate(2px,0)" />
        </Style>
        <Style Selector="Button.tactical-nav-primary:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource DxSurfaceSelectedBrush}" />
        </Style>
        <Style Selector="Button.tactical-nav-primary:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Button.Styles>
      <TextBlock Text="{Binding ButtonLabel}"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="15"
                 FontWeight="Bold"
                 LetterSpacing="1.5"
                 Foreground="{DynamicResource DxAccentPrimaryBrush}" />
    </Button>
  </DataTemplate>

  <!-- Secondary nav rows (Load / CnCNet / LAN / Skirmish / Options / Exit). -->
  <DataTemplate x:Key="DxMainMenuTacticalNav" DataType="vm:UiNodeViewModel">
    <Button MinHeight="36"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            Cursor="Hand"
            Classes="tactical-nav">
      <Button.Styles>
        <Style Selector="Button.tactical-nav">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="12,6" />
          <Setter Property="CornerRadius" Value="0" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button.tactical-nav:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource DxSurfaceSelectedBrush}" />
          <Setter Property="RenderTransform" Value="translate(2px,0)" />
        </Style>
        <Style Selector="Button.tactical-nav:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{DynamicResource DxSurfaceSelectedBrush}" />
        </Style>
        <Style Selector="Button.tactical-nav:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Button.Styles>
      <TextBlock Text="{Binding ButtonLabel}"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="13.5"
                 FontWeight="SemiBold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource DxTextPrimaryBrush}" />
    </Button>
  </DataTemplate>

  <!-- Footer secondary links (Statistics / Credits / Map Editor). -->
  <DataTemplate x:Key="DxMainMenuTacticalLink" DataType="vm:UiNodeViewModel">
    <Button MinHeight="28"
            Padding="10,4"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            Cursor="Hand"
            Classes="tactical-link">
      <Button.Styles>
        <Style Selector="Button.tactical-link">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource DxLineMutedBrush}" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.tactical-link:pointerover">
          <Setter Property="Background" Value="{DynamicResource DxSurfaceSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource DxAccentPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tactical-link:disabled">
          <Setter Property="Opacity" Value="0.4" />
        </Style>
      </Button.Styles>
      <TextBlock Text="{Binding ButtonLabel}"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="11"
                 FontWeight="SemiBold"
                 LetterSpacing="1"
                 Foreground="{DynamicResource DxTextMutedBrush}" />
    </Button>
  </DataTemplate>

  <!-- Telemetry chip labels (version / online / update). -->
  <DataTemplate x:Key="DxMainMenuTacticalStatus" DataType="vm:UiNodeViewModel">
    <Border Padding="8,3"
            CornerRadius="0"
            BorderBrush="{DynamicResource DxLineMutedBrush}"
            BorderThickness="1"
            Background="#22000000"
            IsVisible="{Binding IsVisible}">
      <TextBlock Text="{Binding Text}"
                 FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"
                 FontSize="11"
                 Foreground="{DynamicResource DxTextPrimaryBrush}"
                 VerticalAlignment="Center"
                 ToolTip.Tip="{Binding ToolTip}" />
    </Border>
  </DataTemplate>

  <!-- Clickable status (lblVersion / lblUpdateStatus) — keep ClickCommand. -->
  <DataTemplate x:Key="DxMainMenuTacticalStatusLink" DataType="vm:UiNodeViewModel">
    <Button Padding="0"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            Cursor="Hand"
            HorizontalContentAlignment="Left">
      <Border Padding="8,3"
              CornerRadius="0"
              BorderBrush="{DynamicResource DxLineMutedBrush}"
              BorderThickness="1"
              Background="#22000000">
        <TextBlock Text="{Binding Text}"
                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI, monospace"
                   FontSize="11"
                   Foreground="{DynamicResource DxAccentPrimaryBrush}"
                   TextDecorations="Underline"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{Binding ToolTip}" />
      </Border>
    </Button>
  </DataTemplate>

</ResourceDictionary>
