<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ClientAvalonia.Rendering"
                    xmlns:views="using:ClientAvalonia.Views"
                    xmlns:ctrl="using:ClientAvalonia.Controls">

  <SolidColorBrush x:Key="DxTextPrimaryBrush" Color="#F2E6D8" />
  <SolidColorBrush x:Key="DxTextMutedBrush" Color="#B8AA9A" />

  <!-- Recursive child host (Canvas-positioned ItemsControl) -->
  <DataTemplate x:Key="DxChildHost" DataType="vm:UiNodeViewModel">
    <views:DxNodeCanvasView DataContext="{Binding}" />
  </DataTemplate>

  <DataTemplate x:Key="DxControlHost" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}">
      <TextBlock Text="{Binding Id}" Opacity="0.4" FontSize="10" />
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="MapPreviewBox" DataType="vm:UiNodeViewModel">
    <Button Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Width="{Binding Width}"
            Height="{Binding Height}"
            Command="{Binding ClickCommand}"
            ToolTip.Tip="Click to toggle favorite map">
      <Panel ClipToBounds="True">
        <Border Background="#CC0E0C0A"
                CornerRadius="6"
                BorderBrush="#6B4E2E"
                BorderThickness="1" />
        <Border Margin="1"
                CornerRadius="5"
                BorderBrush="#20FFA648"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />
        <Image Source="{Binding PreviewImage}"
               Stretch="{Binding PreviewImageStretch}"
               IsVisible="{Binding HasPreviewImage}"
               IsHitTestVisible="False" />
        <TextBlock Text="No preview"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="#666"
                   FontSize="11"
                   IsVisible="{Binding !HasPreviewImage}" />
      </Panel>
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="DxPanel" DataType="vm:UiNodeViewModel">
    <Panel Width="{Binding Width}"
           Height="{Binding Height}"
           IsVisible="{Binding IsVisible}"
           ClipToBounds="False">
      <Image Source="{Binding BackgroundImage}"
             Stretch="{Binding BackgroundImageStretch}"
             IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
             IsHitTestVisible="False" />
      <Border Background="{Binding TiledBackgroundBrush}"
              IsVisible="{Binding UseTiledBackground}"
              IsHitTestVisible="False" />
      <Border Background="{Binding BackgroundBrush}"
              CornerRadius="8"
              BorderBrush="#6B4E2E"
              BorderThickness="1"
              IsHitTestVisible="False" />
      <Border Margin="1"
              CornerRadius="7"
              BorderBrush="#30FFA648"
              BorderThickness="0,1,0,0"
              IsHitTestVisible="False" />
      <views:DxNodeCanvasView DataContext="{Binding}" />
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="DxOptionsScrollPanel" DataType="vm:UiNodeViewModel">
    <Panel Width="{Binding Width}"
           Height="{Binding Height}"
           IsVisible="{Binding IsVisible}"
           ClipToBounds="True">
      <Border Background="{Binding BackgroundBrush}"
              CornerRadius="6"
              BorderBrush="#8A6238"
              BorderThickness="1"
              IsHitTestVisible="False" />
      <ScrollViewer Margin="3"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Panel MinHeight="{Binding ScrollContentHeight}"
               Width="{Binding Width}">
          <views:DxNodeCanvasView DataContext="{Binding}" />
        </Panel>
      </ScrollViewer>
    </Panel>
  </DataTemplate>

  <DataTemplate x:Key="DxTabButton" DataType="vm:UiNodeViewModel">
    <ctrl:DxTabButton DataContext="{Binding}" />
  </DataTemplate>

  <DataTemplate x:Key="DxButton" DataType="vm:UiNodeViewModel">
    <ctrl:DxTextureButton DataContext="{Binding}" />
  </DataTemplate>

  <DataTemplate x:Key="DxLinkButton" DataType="vm:UiNodeViewModel">
    <ctrl:DxTextureButton DataContext="{Binding}" />
  </DataTemplate>

  <DataTemplate x:Key="DxLabel" DataType="vm:UiNodeViewModel">
    <TextBlock MaxWidth="{Binding ContentMaxWidth}"
               MinHeight="{Binding Height}"
               Text="{Binding Text}"
               Foreground="{Binding ForegroundBrush}"
               FontFamily="{Binding LabelFontFamily}"
               IsVisible="{Binding IsVisible}"
               VerticalAlignment="Top"
               FontSize="{Binding FontSize}"
               TextWrapping="Wrap"
               LineHeight="20"
               ToolTip.Tip="{Binding ToolTip}" />
  </DataTemplate>

  <DataTemplate x:Key="DxLinkLabel" DataType="vm:UiNodeViewModel">
    <Button Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Width="{Binding Width}"
            Height="{Binding Height}"
            Command="{Binding ClickCommand}"
            HorizontalContentAlignment="Left"
            VerticalContentAlignment="Center">
      <TextBlock Text="{Binding Text}"
                 Foreground="{Binding ForegroundBrush}"
                 FontSize="12"
                 TextDecorations="Underline"
                 ToolTip.Tip="{Binding ToolTip}" />
    </Button>
  </DataTemplate>

  <DataTemplate x:Key="DxCheckBox" DataType="vm:UiNodeViewModel">
    <ctrl:DxThemeCheckBox DataContext="{Binding}" />
  </DataTemplate>

  <DataTemplate x:Key="DxComboBox" DataType="vm:UiNodeViewModel">
    <ComboBox MinWidth="{Binding Width}"
              MinHeight="{Binding Height}"
              MaxWidth="{Binding ContentMaxWidth}"
              Background="#CC14100C"
              BorderBrush="#6B4E2E"
              Foreground="{StaticResource DxTextPrimaryBrush}"
              FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
              FontSize="12.5"
              Padding="10,6"
              CornerRadius="6"
              ItemsSource="{Binding ComboItems}"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
              IsEnabled="{Binding IsEnabled}"
              IsVisible="{Binding IsVisible}"
              PlaceholderText="{Binding Text}"
              ToolTip.Tip="{Binding ToolTip}" />
  </DataTemplate>

  <DataTemplate x:Key="DxLobbyComboBox" DataType="vm:UiNodeViewModel">
    <ComboBox Width="{Binding Width}"
              Height="{Binding Height}"
              MinWidth="{Binding Width}"
              MaxWidth="{Binding Width}"
              MinHeight="{Binding Height}"
              MaxHeight="{Binding Height}"
              Background="#CC14100C"
              BorderBrush="#6B4E2E"
              Foreground="{StaticResource DxTextPrimaryBrush}"
              FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
              FontSize="11"
              Padding="4,2"
              CornerRadius="4"
              ItemsSource="{Binding ComboItems}"
              SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
              IsEnabled="{Binding IsEnabled}"
              IsVisible="{Binding IsVisible}"
              PlaceholderText="{Binding Text}"
              ToolTip.Tip="{Binding ToolTip}" />
  </DataTemplate>

  <DataTemplate x:Key="DxTextBox" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            MinWidth="{Binding Width}"
            MaxWidth="{Binding Width}"
            MinHeight="{Binding Height}"
            CornerRadius="6"
            BorderBrush="#5A4632"
            BorderThickness="1"
            Background="#CC14100C"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ClipToBounds="True">
      <Panel>
        <Image Source="{Binding BackgroundImage}"
               Stretch="{Binding BackgroundImageStretch}"
               Opacity="0.15"
               IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
               IsHitTestVisible="False" />
        <Border Background="{Binding TiledBackgroundBrush}"
                Opacity="0.15"
                IsVisible="{Binding UseTiledBackground}"
                IsHitTestVisible="False" />
        <TextBox Background="Transparent"
                 BorderThickness="0"
                 Foreground="{StaticResource DxTextPrimaryBrush}"
                 FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                 FontSize="12.5"
                 Padding="10,8"
                 Watermark="{Binding Watermark}"
                 Text="{Binding InputText, Mode=TwoWay}"
                 ToolTip.Tip="{Binding ToolTip}" />
      </Panel>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DxListBox" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            CornerRadius="6"
            BorderBrush="#5A4632"
            BorderThickness="1"
            Background="#CC14100C"
            ClipToBounds="True"
            IsVisible="{Binding IsVisible}">
      <ListBox Background="Transparent"
               BorderThickness="0"
               Padding="4,4"
               ItemsSource="{Binding ListItems}"
               SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
               IsEnabled="{Binding IsEnabled}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                       FontSize="12.5"
                       Foreground="{StaticResource DxTextPrimaryBrush}"
                       TextWrapping="Wrap"
                       Padding="8,6" />
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#28FFFFFF" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#383020" />
          </Style>
        </ListBox.Styles>
      </ListBox>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="DxProgressBar" DataType="vm:UiNodeViewModel">
    <ProgressBar Width="{Binding Width}"
                 Height="{Binding Height}"
                 IsVisible="{Binding IsVisible}" />
  </DataTemplate>

  <DataTemplate x:Key="DxSlider" DataType="vm:UiNodeViewModel">
    <Slider Width="{Binding Width}"
            Minimum="0"
            Maximum="2"
            Value="{Binding SelectedIndex, Mode=TwoWay}"
            TickFrequency="1"
            IsSnapToTickEnabled="True"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}" />
  </DataTemplate>

  <DataTemplate x:Key="DxScrollViewer" DataType="vm:UiNodeViewModel">
    <ScrollViewer Width="{Binding Width}"
                  Height="{Binding Height}"
                  IsVisible="{Binding IsVisible}">
      <views:DxNodeCanvasView DataContext="{Binding}" />
    </ScrollViewer>
  </DataTemplate>

  <DataTemplate x:Key="DxTabControl" DataType="vm:UiNodeViewModel">
    <TabControl Width="{Binding Width}"
                Height="{Binding Height}"
                IsVisible="{Binding IsVisible}">
      <views:DxNodeCanvasView DataContext="{Binding}" />
    </TabControl>
  </DataTemplate>

  <DataTemplate x:Key="DxIndicator" DataType="vm:UiNodeViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
      <Border Width="16" Height="16" Background="#444" />
      <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- Leaf presenter used inside canvas item template -->
  <DataTemplate x:Key="DxNodeLeaf" DataType="vm:UiNodeViewModel">
    <ContentControl Content="{Binding}">
      <ContentControl.ContentTemplate>
        <views:DxNodeTemplateSelector />
      </ContentControl.ContentTemplate>
    </ContentControl>
  </DataTemplate>

</ResourceDictionary>
