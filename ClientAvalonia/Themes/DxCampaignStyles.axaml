<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ClientAvalonia.Rendering"
                    xmlns:views="using:ClientAvalonia.Views">

  <!-- Campaign window root: gradient shell over INI background texture -->
  <DataTemplate x:Key="DxCampaignRoot" DataType="vm:UiNodeViewModel">
    <Panel Width="{Binding Width}"
           Height="{Binding Height}"
           IsVisible="{Binding IsVisible}"
           ClipToBounds="True">
      <Image Source="{Binding BackgroundImage}"
             Stretch="{Binding BackgroundImageStretch}"
             Opacity="0.28"
             IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
             IsHitTestVisible="False" />
      <Border Background="{Binding TiledBackgroundBrush}"
              Opacity="0.28"
              IsVisible="{Binding UseTiledBackground}"
              IsHitTestVisible="False" />
      <Border Background="{StaticResource DxCampaignSurfaceGradient}"
              CornerRadius="10"
              IsHitTestVisible="False" />
      <Border Height="3"
              VerticalAlignment="Top"
              Background="{StaticResource DxCampaignAccentGradient}"
              CornerRadius="10,10,0,0"
              IsHitTestVisible="False" />
      <Border Margin="0,3,0,0"
              CornerRadius="0,0,10,10"
              BorderBrush="{StaticResource DxCampaignBorderGlowBrush}"
              BorderThickness="1"
              IsHitTestVisible="False" />
      <views:DxNodeCanvasView DataContext="{Binding}" />
    </Panel>
  </DataTemplate>

  <!-- Section titles: MISSIONS / MISSION DESCRIPTION / DIFFICULTY -->
  <DataTemplate x:Key="DxCampaignSectionHeader" DataType="vm:UiNodeViewModel">
    <StackPanel MinHeight="{Binding Height}"
                Spacing="6"
                IsVisible="{Binding IsVisible}">
      <TextBlock Text="{Binding Text}"
                 Foreground="{StaticResource DxCampaignHeaderBrush}"
                 FontFamily="{Binding LabelFontFamily}"
                 FontSize="13.5"
                 FontWeight="Bold"
                 LetterSpacing="1.2"
                 TextWrapping="Wrap" />
      <Border Height="2"
              Width="52"
              HorizontalAlignment="Left"
              Background="{StaticResource DxCampaignAccentGradient}"
              CornerRadius="1" />
    </StackPanel>
  </DataTemplate>

  <!-- Mission list -->
  <DataTemplate x:Key="DxCampaignListBox" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            ClipToBounds="True">
      <Panel>
        <Border Margin="1"
                CornerRadius="7"
                BorderBrush="#18FFFFFF"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />
        <ListBox ItemsSource="{Binding CatalogListItems}"
               SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
               IsEnabled="{Binding IsEnabled}"
               Background="Transparent"
               BorderThickness="0"
               Padding="6,8">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CatalogListItemViewModel">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Opacity="{Binding Opacity}"
                        Margin="0,2">
              <Image Source="{Binding Icon}"
                     Width="20"
                     Height="20"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     Opacity="{Binding Opacity}"
                     IsVisible="{Binding HasIcon}" />
              <TextBlock Text="{Binding Text}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                         FontSize="13"
                         Foreground="{Binding ForegroundBrush}"
                         TextWrapping="Wrap"
                         LineHeight="20"
                         VerticalAlignment="Center"
                         Padding="0,5"
                         ToolTip.Tip="{Binding ToolTip}"
                         IsVisible="{Binding !IsHeader}" />
              <TextBlock Text="{Binding Text}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                         FontSize="11.5"
                         FontWeight="Bold"
                         Foreground="{StaticResource DxCampaignHeaderBrush}"
                         TextAlignment="Center"
                         HorizontalAlignment="Stretch"
                         TextWrapping="Wrap"
                         LineHeight="16"
                         VerticalAlignment="Center"
                         Padding="0,12,0,6"
                         LetterSpacing="0.8"
                         Opacity="0.9"
                         IsVisible="{Binding IsHeader}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="28" />
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource DxCampaignListHoverBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource DxCampaignListSelectedBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DxCampaignListSelectedBrush}" />
          </Style>
          <Style Selector="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Opacity" Value="0.85" />
          </Style>
          <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="8" />
          </Style>
          <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#AA8C5A32" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="28" />
          </Style>
          <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="#CCFF8C32" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      </Panel>
    </Border>
  </DataTemplate>

  <!-- Mission briefing / description panel -->
  <DataTemplate x:Key="DxCampaignBriefing" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            ClipToBounds="True">
      <Panel>
        <Image Source="{Binding BackgroundImage}"
               Stretch="{Binding BackgroundImageStretch}"
               Opacity="0.12"
               IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
               IsHitTestVisible="False" />
        <Border Background="{Binding TiledBackgroundBrush}"
                Opacity="0.12"
                IsVisible="{Binding UseTiledBackground}"
                IsHitTestVisible="False" />
        <Border Background="#CC0E0C0A"
                CornerRadius="8"
                IsHitTestVisible="False" />
        <Border Margin="1"
                CornerRadius="7"
                BorderBrush="#12FFFFFF"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />
        <Grid Margin="14,12,8,12" RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Margin="0,0,6,10"
                  Height="120"
                  CornerRadius="6"
                  BorderBrush="{StaticResource DxCampaignBorderBrush}"
                  BorderThickness="1"
                  Background="#66000000"
                  ClipToBounds="True"
                  IsVisible="{Binding HasPreviewImage}">
            <Image Source="{Binding PreviewImage}"
                   Stretch="{Binding PreviewImageStretch}"
                   StretchDirection="Both"
                   IsHitTestVisible="False" />
          </Border>
          <ScrollViewer Grid.Row="1"
                        Margin="0,0,2,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Styles>
              <Style Selector="ScrollBar">
                <Setter Property="Width" Value="9" />
                <Setter Property="AllowAutoHide" Value="False" />
              </Style>
              <Style Selector="ScrollBar /template/ RepeatButton">
                <Setter Property="IsVisible" Value="False" />
              </Style>
              <Style Selector="ScrollBar /template/ Thumb">
                <Setter Property="Background" Value="#BB8C5A32" />
                <Setter Property="CornerRadius" Value="4.5" />
                <Setter Property="BorderBrush" Value="#66FFD4A8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="32" />
              </Style>
              <Style Selector="ScrollBar /template/ Thumb:pointerover">
                <Setter Property="Background" Value="#DDFF8C32" />
              </Style>
              <Style Selector="ScrollBar /template/ Border#Track">
                <Setter Property="Background" Value="#22000000" />
              </Style>
            </ScrollViewer.Styles>
            <Panel>
            <!-- Structured briefing -->
            <StackPanel Spacing="12"
                        IsVisible="{Binding UseStructuredBriefing}">
              <TextBlock Text="{Binding BriefingTitle}"
                         FontFamily="{Binding LabelFontFamily}"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{StaticResource DxCampaignHeaderBrush}"
                         TextWrapping="Wrap"
                         IsVisible="{Binding HasBriefingTitle}" />
              <Border Background="#221810"
                      BorderBrush="#66553A22"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding HasBriefingLocation}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="地点"
                             FontFamily="{Binding LabelFontFamily}"
                             FontSize="11.5"
                             FontWeight="Bold"
                             Foreground="{StaticResource DxAccentSoftBrush}"
                             VerticalAlignment="Center" />
                  <Border Width="1" Height="12" Background="#55FF8C32" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding BriefingLocation}"
                             FontFamily="{Binding LabelFontFamily}"
                             FontSize="13"
                             Foreground="{StaticResource DxTextPrimaryBrush}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBlock Text="{Binding BriefingBody}"
                         FontFamily="{Binding LabelFontFamily}"
                         FontSize="13.5"
                         Foreground="{StaticResource DxTextPrimaryBrush}"
                         TextWrapping="Wrap"
                         LineHeight="22"
                         Opacity="0.92"
                         IsVisible="{Binding HasBriefingBody}" />
              <StackPanel Spacing="8" IsVisible="{Binding HasBriefingObjectives}">
                <TextBlock Text="任务目标"
                           FontFamily="{Binding LabelFontFamily}"
                           FontSize="12.5"
                           FontWeight="Bold"
                           LetterSpacing="0.8"
                           Foreground="{StaticResource DxCampaignHeaderBrush}" />
                <ItemsControl ItemsSource="{Binding BriefingObjectives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="#18140F"
                              BorderBrush="#44382818"
                              BorderThickness="1"
                              CornerRadius="5"
                              Padding="10,7"
                              Margin="0,0,0,6">
                        <DockPanel LastChildFill="True">
                          <Border DockPanel.Dock="Left"
                                  Width="6"
                                  Height="6"
                                  Margin="0,5,10,0"
                                  CornerRadius="3"
                                  Background="{StaticResource DxAccentBrush}"
                                  VerticalAlignment="Top" />
                          <TextBlock Text="{Binding}"
                                     FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                                     FontSize="13"
                                     Foreground="{StaticResource DxTextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     LineHeight="20" />
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Border Background="#33A04020"
                      BorderBrush="#88FF8C32"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="10,8"
                      IsVisible="{Binding HasBriefingStatusHint}">
                <TextBlock Text="{Binding BriefingStatusHint}"
                           FontFamily="{Binding LabelFontFamily}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource DxAccentSoftBrush}"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
            <!-- Plain fallback -->
            <TextBlock Text="{Binding Text}"
                       FontFamily="{Binding LabelFontFamily}"
                       FontSize="13.5"
                       Foreground="{StaticResource DxTextPrimaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Opacity="0.92"
                       IsVisible="{Binding UseStructuredBriefing, Converter={x:Static BoolConverters.Not}}" />
            </Panel>
          </ScrollViewer>
        </Grid>
      </Panel>
    </Border>
  </DataTemplate>

  <!-- Faction filter tabs (GDI / Nod / ThirdSide) -->
  <DataTemplate x:Key="DxCampaignSideTab" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinWidth="88"
            MinHeight="34"
            Padding="14,8"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="#221C16"
                      BorderBrush="{StaticResource DxCampaignBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="17"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#352818" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource DxCampaignListSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentSoftBrush}" />
        </Style>
      </Button.Styles>
      <Panel>
        <Border Background="{StaticResource DxCampaignListSelectedBrush}"
                BorderBrush="{StaticResource DxAccentSoftBrush}"
                BorderThickness="1"
                CornerRadius="17"
                IsVisible="{Binding IsTabSelected}"
                IsHitTestVisible="False"
                Opacity="0.35" />
        <StackPanel Spacing="6" HorizontalAlignment="Center">
        <Image Source="{Binding SideIcon}"
               Width="28"
               Height="28"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               IsVisible="{Binding HasSideIcon}" />
        <TextBlock Text="{Binding Text}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DxTextPrimaryBrush}"
                   TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </Button>
  </DataTemplate>

  <!-- Difficulty labels (Easy / Normal / Hard) -->
  <DataTemplate x:Key="DxCampaignDifficultyLabel" DataType="vm:UiNodeViewModel">
    <TextBlock Text="{Binding Text}"
               MinHeight="{Binding Height}"
               Foreground="{StaticResource DxTextMutedBrush}"
               FontFamily="{Binding LabelFontFamily}"
               FontSize="11.5"
               FontWeight="Medium"
               LetterSpacing="0.8"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsVisible="{Binding IsVisible}" />
  </DataTemplate>

  <!-- Difficulty slider: custom orange track + thumb (no Fluent blue ticks) -->
  <DataTemplate x:Key="DxCampaignDifficultySlider" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            MinHeight="44"
            Padding="16,14"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            IsEnabled="{Binding IsEnabled}">
      <Slider Minimum="0"
              Maximum="2"
              Value="{Binding SelectedIndex, Mode=TwoWay}"
              IsSnapToTickEnabled="True"
              TickFrequency="1"
              MinHeight="28"
              Background="#2A2018"
              Foreground="#FF8C32">
        <Slider.Styles>
          <Style Selector="Slider:horizontal">
            <Setter Property="Template">
              <ControlTemplate>
                <Grid Margin="4,0" MinHeight="24">
                  <!-- Full track -->
                  <Border Height="6"
                          CornerRadius="3"
                          VerticalAlignment="Center"
                          Margin="9,0"
                          Background="#2A2018"
                          BorderBrush="#55382818"
                          BorderThickness="1" />
                  <Track Name="PART_Track"
                         Orientation="Horizontal"
                         Minimum="{TemplateBinding Minimum}"
                         Maximum="{TemplateBinding Maximum}"
                         Value="{TemplateBinding Value, Mode=TwoWay}">
                    <Track.DecreaseButton>
                      <RepeatButton Name="PART_DecreaseButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsTabStop="False">
                        <RepeatButton.Template>
                          <ControlTemplate>
                            <Border Background="Transparent"
                                    VerticalAlignment="Center"
                                    Height="6"
                                    CornerRadius="3,0,0,3">
                              <Border Background="{StaticResource DxCampaignAccentGradient}"
                                      CornerRadius="3,0,0,3"
                                      Height="6" />
                            </Border>
                          </ControlTemplate>
                        </RepeatButton.Template>
                      </RepeatButton>
                    </Track.DecreaseButton>
                    <Track.IncreaseButton>
                      <RepeatButton Name="PART_IncreaseButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    IsTabStop="False">
                        <RepeatButton.Template>
                          <ControlTemplate>
                            <Border Background="Transparent" Height="6" VerticalAlignment="Center" />
                          </ControlTemplate>
                        </RepeatButton.Template>
                      </RepeatButton>
                    </Track.IncreaseButton>
                    <Track.Thumb>
                      <Thumb Width="22" Height="22" Cursor="Hand">
                        <Thumb.Template>
                          <ControlTemplate>
                            <Grid Width="22" Height="22">
                              <Ellipse Width="22"
                                       Height="22"
                                       Fill="#FF8C32"
                                       Stroke="#FFD4A8"
                                       StrokeThickness="2" />
                              <Ellipse Width="7"
                                       Height="7"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Fill="#FFF2E6D8" />
                            </Grid>
                          </ControlTemplate>
                        </Thumb.Template>
                      </Thumb>
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter>
          </Style>
        </Slider.Styles>
      </Slider>
    </Border>
  </DataTemplate>

  <!-- Launch (primary) -->
  <DataTemplate x:Key="DxCampaignPrimaryButton" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinHeight="36"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="{StaticResource DxCampaignPrimaryButtonGradient}"
                      BorderBrush="#FFD4A8"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,6"
                      BoxShadow="0 2 8 0 #40000000">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource DxCampaignPrimaryButtonHoverGradient}" />
          <Setter Property="BoxShadow" Value="0 4 14 0 #55FF8C32" />
        </Style>
        <Style Selector="Button:disabled /template/ Border#Root">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </Button.Styles>
      <Panel>
        <Image Source="{Binding IdleImage}"
               Stretch="Fill"
               Opacity="0.35"
               IsVisible="{Binding HasTextureImage}"
               IsHitTestVisible="False" />
        <Border Background="{StaticResource DxCampaignPrimaryButtonGradient}"
                BorderBrush="#FFD4A8"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasTextureImage, Converter={x:Static BoolConverters.Not}}"
                IsHitTestVisible="False" />
        <TextBlock Text="{Binding ButtonLabel}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="Bold"
                   Foreground="#FF20160C"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Panel>
    </Button>
  </DataTemplate>

  <!-- Cancel (secondary) -->
  <DataTemplate x:Key="DxCampaignSecondaryButton" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinHeight="36"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="#18000000"
                      BorderBrush="{StaticResource DxCampaignBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12,6">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#28FFFFFF" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentBrush}" />
        </Style>
      </Button.Styles>
      <Panel>
        <Image Source="{Binding IdleImage}"
               Stretch="Fill"
               Opacity="0.25"
               IsVisible="{Binding HasTextureImage}"
               IsHitTestVisible="False" />
        <Border Background="#18000000"
                BorderBrush="{StaticResource DxCampaignBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasTextureImage, Converter={x:Static BoolConverters.Not}}"
                IsHitTestVisible="False" />
        <TextBlock Text="{Binding ButtonLabel}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DxTextPrimaryBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Panel>
    </Button>
  </DataTemplate>

</ResourceDictionary>
