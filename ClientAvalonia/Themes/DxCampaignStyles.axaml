<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:ClientAvalonia.Rendering"
                    xmlns:views="using:ClientAvalonia.Views">

  <!-- Campaign window root: gradient shell over INI background texture -->
  <DataTemplate x:Key="DxCampaignRoot" DataType="vm:UiNodeViewModel">
    <Panel Width="{Binding Width}"
           Height="{Binding Height}"
           IsVisible="{Binding IsVisible}"
           ClipToBounds="True">
      <Image Source="{Binding BackgroundImage}"
             Stretch="{Binding BackgroundImageStretch}"
             Opacity="0.28"
             IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
             IsHitTestVisible="False" />
      <Border Background="{Binding TiledBackgroundBrush}"
              Opacity="0.28"
              IsVisible="{Binding UseTiledBackground}"
              IsHitTestVisible="False" />
      <Border Background="{StaticResource DxCampaignSurfaceGradient}"
              CornerRadius="10"
              IsHitTestVisible="False" />
      <Border Height="3"
              VerticalAlignment="Top"
              Background="{StaticResource DxCampaignAccentGradient}"
              CornerRadius="10,10,0,0"
              IsHitTestVisible="False" />
      <Border Margin="0,3,0,0"
              CornerRadius="0,0,10,10"
              BorderBrush="{StaticResource DxCampaignBorderGlowBrush}"
              BorderThickness="1"
              IsHitTestVisible="False" />
      <views:DxNodeCanvasView DataContext="{Binding}" />
    </Panel>
  </DataTemplate>

  <!-- Section titles: MISSIONS / MISSION DESCRIPTION / DIFFICULTY -->
  <DataTemplate x:Key="DxCampaignSectionHeader" DataType="vm:UiNodeViewModel">
    <StackPanel MinHeight="{Binding Height}"
                Spacing="6"
                IsVisible="{Binding IsVisible}">
      <TextBlock Text="{Binding Text}"
                 Foreground="{StaticResource DxCampaignHeaderBrush}"
                 FontFamily="{Binding LabelFontFamily}"
                 FontSize="13.5"
                 FontWeight="Bold"
                 LetterSpacing="1.2"
                 TextWrapping="Wrap" />
      <Border Height="2"
              Width="52"
              HorizontalAlignment="Left"
              Background="{StaticResource DxCampaignAccentGradient}"
              CornerRadius="1" />
    </StackPanel>
  </DataTemplate>

  <!-- Mission list -->
  <DataTemplate x:Key="DxCampaignListBox" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            ClipToBounds="True">
      <Panel>
        <Border Margin="1"
                CornerRadius="7"
                BorderBrush="#18FFFFFF"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />
        <ListBox ItemsSource="{Binding CatalogListItems}"
               SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
               IsEnabled="{Binding IsEnabled}"
               Background="Transparent"
               BorderThickness="0"
               Padding="4,6">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:CatalogListItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="{Binding Icon}"
                     Width="22"
                     Height="22"
                     Stretch="Uniform"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasIcon}" />
              <TextBlock Text="{Binding Text}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                         FontSize="13"
                         Foreground="{StaticResource DxTextPrimaryBrush}"
                         TextWrapping="Wrap"
                         LineHeight="20"
                         VerticalAlignment="Center"
                         Padding="0,6"
                         IsVisible="{Binding !IsHeader}" />
              <TextBlock Text="{Binding Text}"
                         FontFamily="Microsoft YaHei UI, Segoe UI, sans-serif"
                         FontSize="12.5"
                         FontWeight="Bold"
                         Foreground="{StaticResource DxCampaignHeaderBrush}"
                         TextAlignment="Center"
                         HorizontalAlignment="Stretch"
                         TextWrapping="Wrap"
                         LineHeight="18"
                         VerticalAlignment="Center"
                         Padding="0,8"
                         LetterSpacing="0.6"
                         IsVisible="{Binding IsHeader}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IsEnabled" Value="True" />
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="{StaticResource DxCampaignListHoverBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{StaticResource DxCampaignListSelectedBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DxAccentSoftBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
          </Style>
        </ListBox.Styles>
      </ListBox>
      </Panel>
    </Border>
  </DataTemplate>

  <!-- Mission briefing / description panel -->
  <DataTemplate x:Key="DxCampaignBriefing" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            Height="{Binding Height}"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            ClipToBounds="True">
      <Panel>
        <Image Source="{Binding BackgroundImage}"
               Stretch="{Binding BackgroundImageStretch}"
               Opacity="0.12"
               IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
               IsHitTestVisible="False" />
        <Border Background="{Binding TiledBackgroundBrush}"
                Opacity="0.12"
                IsVisible="{Binding UseTiledBackground}"
                IsHitTestVisible="False" />
        <Border Background="#CC0E0C0A"
                CornerRadius="8"
                IsHitTestVisible="False" />
        <Border Margin="1"
                CornerRadius="7"
                BorderBrush="#12FFFFFF"
                BorderThickness="0,1,0,0"
                IsHitTestVisible="False" />
        <Grid Margin="14,12" RowDefinitions="Auto,*">
          <Border Grid.Row="0"
                  Margin="0,0,0,10"
                  Height="120"
                  CornerRadius="6"
                  BorderBrush="{StaticResource DxCampaignBorderBrush}"
                  BorderThickness="1"
                  Background="#66000000"
                  ClipToBounds="True"
                  IsVisible="{Binding HasPreviewImage}">
            <Image Source="{Binding PreviewImage}"
                   Stretch="{Binding PreviewImageStretch}"
                   StretchDirection="Both"
                   IsHitTestVisible="False" />
          </Border>
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Text}"
                       FontFamily="{Binding LabelFontFamily}"
                       FontSize="13.5"
                       Foreground="{StaticResource DxTextPrimaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Opacity="0.92" />
          </ScrollViewer>
        </Grid>
      </Panel>
    </Border>
  </DataTemplate>

  <!-- Faction filter tabs (GDI / Nod / ThirdSide) -->
  <DataTemplate x:Key="DxCampaignSideTab" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinWidth="88"
            MinHeight="34"
            Padding="14,8"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="#221C16"
                      BorderBrush="{StaticResource DxCampaignBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="17"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#352818" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource DxCampaignListSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentSoftBrush}" />
        </Style>
      </Button.Styles>
      <Panel>
        <Border Background="{StaticResource DxCampaignListSelectedBrush}"
                BorderBrush="{StaticResource DxAccentSoftBrush}"
                BorderThickness="1"
                CornerRadius="17"
                IsVisible="{Binding IsTabSelected}"
                IsHitTestVisible="False"
                Opacity="0.35" />
        <StackPanel Spacing="6" HorizontalAlignment="Center">
        <Image Source="{Binding SideIcon}"
               Width="28"
               Height="28"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               IsVisible="{Binding HasSideIcon}" />
        <TextBlock Text="{Binding Text}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="12.5"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DxTextPrimaryBrush}"
                   TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </Button>
  </DataTemplate>

  <!-- Difficulty labels (Easy / Normal / Hard) -->
  <DataTemplate x:Key="DxCampaignDifficultyLabel" DataType="vm:UiNodeViewModel">
    <TextBlock Text="{Binding Text}"
               MinHeight="{Binding Height}"
               Foreground="{StaticResource DxTextMutedBrush}"
               FontFamily="{Binding LabelFontFamily}"
               FontSize="11.5"
               FontWeight="Medium"
               LetterSpacing="0.8"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsVisible="{Binding IsVisible}" />
  </DataTemplate>

  <!-- Difficulty slider -->
  <DataTemplate x:Key="DxCampaignDifficultySlider" DataType="vm:UiNodeViewModel">
    <Border Width="{Binding Width}"
            MinHeight="36"
            Padding="12,10"
            CornerRadius="8"
            BorderBrush="{StaticResource DxCampaignBorderBrush}"
            BorderThickness="1"
            Background="{StaticResource DxCampaignSurfaceElevatedBrush}"
            IsVisible="{Binding IsVisible}"
            IsEnabled="{Binding IsEnabled}">
      <Panel>
        <Image Source="{Binding BackgroundImage}"
               Stretch="{Binding BackgroundImageStretch}"
               Opacity="0.08"
               IsVisible="{Binding BackgroundImage, Converter={x:Static ObjectConverters.IsNotNull}}"
               IsHitTestVisible="False" />
        <Border Background="{Binding TiledBackgroundBrush}"
                Opacity="0.08"
                IsVisible="{Binding UseTiledBackground}"
                IsHitTestVisible="False" />
        <Slider Minimum="0"
                Maximum="2"
                Value="{Binding SelectedIndex, Mode=TwoWay}"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                Margin="4,0" />
        <Image Source="{Binding ThumbImage}"
               Width="22"
               Height="22"
               Stretch="Uniform"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               Margin="12,0,0,0"
               IsHitTestVisible="False"
               IsVisible="{Binding HasThumbImage}" />
      </Panel>
    </Border>
  </DataTemplate>

  <!-- Launch (primary) -->
  <DataTemplate x:Key="DxCampaignPrimaryButton" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinHeight="36"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="{StaticResource DxCampaignPrimaryButtonGradient}"
                      BorderBrush="#FFD4A8"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="20,8"
                      BoxShadow="0 2 8 0 #40000000">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="{StaticResource DxCampaignPrimaryButtonHoverGradient}" />
          <Setter Property="BoxShadow" Value="0 4 14 0 #55FF8C32" />
        </Style>
        <Style Selector="Button:disabled /template/ Border#Root">
          <Setter Property="Opacity" Value="0.45" />
        </Style>
      </Button.Styles>
      <Panel>
        <Image Source="{Binding IdleImage}"
               Stretch="Fill"
               IsVisible="{Binding HasTextureImage}"
               IsHitTestVisible="False" />
        <Border Background="{StaticResource DxCampaignPrimaryButtonGradient}"
                BorderBrush="#FFD4A8"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasTextureImage, Converter={x:Static BoolConverters.Not}}"
                IsHitTestVisible="False" />
        <TextBlock Text="{Binding ButtonLabel}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="Bold"
                   Foreground="{Binding ForegroundBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Panel>
    </Button>
  </DataTemplate>

  <!-- Cancel (secondary) -->
  <DataTemplate x:Key="DxCampaignSecondaryButton" DataType="vm:UiNodeViewModel">
    <Button Width="{Binding Width}"
            Height="{Binding Height}"
            MinHeight="36"
            Command="{Binding ClickCommand}"
            IsEnabled="{Binding IsEnabled}"
            IsVisible="{Binding IsVisible}"
            ToolTip.Tip="{Binding ToolTip}"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Cursor="Hand">
      <Button.Styles>
        <Style Selector="Button">
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Root"
                      Background="#18000000"
                      BorderBrush="{StaticResource DxCampaignBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="20,8">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ Border#Root">
          <Setter Property="Background" Value="#28FFFFFF" />
          <Setter Property="BorderBrush" Value="{StaticResource DxAccentBrush}" />
        </Style>
      </Button.Styles>
      <Panel>
        <Image Source="{Binding IdleImage}"
               Stretch="Fill"
               IsVisible="{Binding HasTextureImage}"
               IsHitTestVisible="False" />
        <Border Background="#18000000"
                BorderBrush="{StaticResource DxCampaignBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                IsVisible="{Binding HasTextureImage, Converter={x:Static BoolConverters.Not}}"
                IsHitTestVisible="False" />
        <TextBlock Text="{Binding ButtonLabel}"
                   FontFamily="{Binding LabelFontFamily}"
                   FontSize="{Binding FontSize}"
                   FontWeight="SemiBold"
                   Foreground="{Binding ForegroundBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Panel>
    </Button>
  </DataTemplate>

</ResourceDictionary>
