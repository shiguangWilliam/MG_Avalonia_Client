[project]
language=C#
primary
lastDtbSucceeded

[sliceDimensions]
TargetFramework=net8.0

[properties]
AssemblyName=clientogl
CommandLineArgsForDesignTimeEvaluation=-langversion:14.0 -define:;DEBUG;GL;TRACE
CompilerGeneratedFilesOutputPath=
MaxSupportedLangVersion=12.0
ProjectAssetsFile=<PATH>obj/project.assets.json
RootNamespace=DTAClient
RunAnalyzers=
RunAnalyzersDuringLiveAnalysis=
SolutionPath=<PATH>../DXClient.slnx
TargetFrameworkIdentifier=.NETCoreApp
TargetPath=<PATH>bin/Debug/UniversalGL/net8.0/clientogl.dll
TargetRefPath=<PATH>obj/Debug/UniversalGL/net8.0/ref/clientogl.dll
TemporaryDependencyNodeTargetIdentifier=net8.0

[commandLineArguments]
/noconfig
/unsafe+
/checked-
/nowarn:1701,1702,WFAC010,WFO0003,1701,1702
/fullpaths
/nostdlib+
/platform:AnyCPU
/errorreport:prompt
/warn:8
/define:DEBUG;GL;TRACE;UNIVERSALGLDEBUG;NET;NET8_0;NETCOREAPP;NET5_0_OR_GREATER;NET6_0_OR_GREATER;NET7_0_OR_GREATER;NET8_0_OR_GREATER;NETCOREAPP1_0_OR_GREATER;NETCOREAPP1_1_OR_GREATER;NETCOREAPP2_0_OR_GREATER;NETCOREAPP2_1_OR_GREATER;NETCOREAPP2_2_OR_GREATER;NETCOREAPP3_0_OR_GREATER;NETCOREAPP3_1_OR_GREATER;DEVELOPMENT_BUILD
/highentropyva+
/debug-
/debug:portable
/filealign:512
/out:obj\Debug\UniversalGL\net8.0\clientogl.dll
/refout:obj\Debug\UniversalGL\net8.0\refint\clientogl.dll
/target:exe
/warnaserror-
/utf8output
/win32icon:clienticon.ico
/win32manifest:app.SystemAware.manifest
/deterministic+
/langversion:14.0
/warnaserror+:NU1605,SYSLIB0011

